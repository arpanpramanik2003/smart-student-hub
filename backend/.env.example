# Backend server
NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false
REQUEST_BODY_LIMIT_MB=50
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
# auto | memory | redis | upstash
AUTH_RATE_LIMIT_BACKEND=auto
# Optional for distributed limiter (Upstash or Redis Cloud free tier)
# REDIS_URL=rediss://default:<password>@<host>:<port>
# UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>

# Observability
LOG_LEVEL=debug
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_PREFIX=ssh_backend_
TRACING_ENABLED=true
# none | console | otlp
TRACING_EXPORTER=console
OTEL_SERVICE_NAME=smart-student-hub-backend
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://your-collector.example/v1/traces

# Local upload serving policy (used only when Cloudinary is unavailable)
# Set to false if uploads are served by a CDN/object storage layer.
EXPOSE_LOCAL_UPLOADS=true
UPLOADS_CACHE_CONTROL_MAX_AGE=1h

# JWT
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRES_IN=7d

# Database
# Option 1: absolute path to an existing SQLite DB file
# DB_PATH=D:/path/to/your/old/smart_student_hub.db
# Option 2: file name/path relative to backend folder
DB_NAME=smart_student_hub.db
# DB sync strategy: none | safe | alter
# production default is none, development default is safe
DB_SYNC_STRATEGY=safe
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Cloudinary (optional in local dev)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin bootstrap
ADMIN_RESET_CODE=CHANGE_ME_secure_reset_code
